<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles -->
    <style name="TextAppearance.ExpenseTracker.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.ExpenseTracker.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.ExpenseTracker.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.ExpenseTracker.BodySecondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.ExpenseTracker.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.ExpenseTracker.Amount" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_amount_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Custom Category Chip Style -->
    <style name="Widget.ExpenseTracker.Chip.Category" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">@dimen/button_height_compact</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Auth bottom sheet over the camera: glass surface, 24dp top corners, keyboard-aware -->
    <style name="ThemeOverlay.ExpenseTracker.AuthSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ExpenseTracker.AuthSheet</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.ExpenseTracker.AuthSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/sheet_glass</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ExpenseTracker.TopSheet</item>
    </style>

    <style name="ShapeAppearance.ExpenseTracker.TopSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Rounded filled text field with leading icon, for dark sheets -->
    <style name="Widget.ExpenseTracker.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card_dark</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_l</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_l</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_l</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_l</item>
        <item name="hintTextColor">@color/colorAccent</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
    </style>

    <!-- One half of the sign in / sign up pill switch -->
    <style name="Widget.ExpenseTracker.SegmentButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/selector_segment_text</item>
        <item name="backgroundTint">@color/selector_segment_bg</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="rippleColor">@color/surface_glass</item>
    </style>
</resources>
