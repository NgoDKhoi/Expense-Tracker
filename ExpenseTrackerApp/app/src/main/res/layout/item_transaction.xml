<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xs"
    android:layout_marginBottom="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_m">

        <!-- 12dp Rounded Thumbnail Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/thumbnail_size"
            android:layout_height="@dimen/thumbnail_size"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_dark">

            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_camera"
                app:tint="@color/text_hint"
                android:contentDescription="Transaction Receipt" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="Title"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/text_secondary"
                android:text="Category"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_tiny"
                android:textColor="@color/text_hint"
                android:text="Date"
                android:layout_marginTop="@dimen/spacing_xxs" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/expense_orange"
            android:text="- 0 ₫" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
