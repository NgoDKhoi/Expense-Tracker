<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clickable="true"
    android:focusable="true">

    <!-- Locket 1:1 Square Card locked to exact same vertical_bias=0.35 and full width as Camera Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_receipt_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:id="@+id/iv_receipt_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/title_photos"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/view_bottom_scrim"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom_up" />

        <TextView
            android:id="@+id/tv_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_glass_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <!-- Top Header synchronized with Camera ll_top_header -->
    <LinearLayout
        android:id="@+id/ll_receipt_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_return"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_receipt_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="@string/cd_more_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Left-aligned Category (with DB color) -> Semantic Amount -> Date & Time -->
    <LinearLayout
        android:id="@+id/ll_receipt_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/btn_back_to_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_receipt_image"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:textColor="@color/expense_orange"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Single Thumb-zone CTA Pill centered at the bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:minHeight="52dp"
        android:paddingHorizontal="28dp"
        android:text="@string/action_back_to_camera"
        android:textColor="@color/white"
        app:backgroundTint="@color/expense_orange"
        app:cornerRadius="@dimen/radius_pill"
        app:icon="@drawable/ic_photo_camera"
        app:iconSize="18dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
