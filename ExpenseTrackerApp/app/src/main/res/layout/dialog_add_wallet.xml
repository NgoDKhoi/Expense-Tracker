<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l"
    android:background="@drawable/rounded_top_sheet">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_m"
        android:background="@drawable/bg_glass_pill" />

    <TextView
        android:id="@+id/tv_dialog_wallet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title_add_wallet"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/spacing_m" />

    <!-- Wallet name input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_wallet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_wallet_name"
        android:textColorHint="@color/text_secondary"
        app:boxStrokeColor="@color/colorAccent"
        app:hintTextColor="@color/colorAccent"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_wallet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Initial balance input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_wallet_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="@string/hint_initial_balance"
        android:textColorHint="@color/text_secondary"
        app:boxStrokeColor="@color/colorAccent"
        app:hintTextColor="@color/colorAccent"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_wallet_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:inputType="numberDecimal"
            android:text="0"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Preset Color Choices -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Màu thẻ"
        android:textSize="@dimen/text_size_caption"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_s" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_wallet_colors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/spacing_l">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_delete"
            android:textColor="#E53935"
            android:visibility="gone"
            style="?attr/borderlessButtonStyle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel"
            android:textColor="@color/text_secondary"
            style="?attr/borderlessButtonStyle"
            android:layout_marginEnd="@dimen/spacing_s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_create"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
