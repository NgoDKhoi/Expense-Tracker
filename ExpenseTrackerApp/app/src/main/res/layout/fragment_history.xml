<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="@dimen/spacing_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_history"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/spacing_m" />

    <!-- Search Input Bar -->
    <LinearLayout
        android:id="@+id/ll_search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_standard"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_pill"
        android:paddingHorizontal="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_s">

        <ImageView
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:src="@drawable/ic_search"
            app:tint="@color/text_hint"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/et_search_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_s"
            android:background="@null"
            android:hint="@string/hint_search_history"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_small"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btn_clear_search"
            android:layout_width="@dimen/icon_size_l"
            android:layout_height="@dimen/icon_size_l"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_hint"
            android:contentDescription="Clear Search" />
    </LinearLayout>

    <!-- Horizontal Filter Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/spacing_s">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_history_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type_all"
                android:checked="true"
                style="@style/Widget.ExpenseTracker.Chip.Category" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type_expense"
                style="@style/Widget.ExpenseTracker.Chip.Category" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type_income"
                style="@style/Widget.ExpenseTracker.Chip.Category" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/empty_state_history"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
