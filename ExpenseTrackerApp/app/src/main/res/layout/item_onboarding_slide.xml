<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_xl">

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_dark">

        <ImageView
            android:id="@+id/iv_slide_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_photo_camera"
            app:tint="@color/colorAccent"
            android:contentDescription="Slide Illustration" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_slide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/onboarding_title_1"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/tv_slide_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/onboarding_desc_1"
        android:textSize="@dimen/text_size_body"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:lineSpacingExtra="6dp" />

</LinearLayout>
